# AI-Ops 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ====================
# 加密配置（推荐）
# ====================

# 加密密钥（Base64 编码的 32 字节随机密钥）
# 生成方法: openssl rand -base64 32
ENCRYPTION_BASE64_KEY=

# 或使用原始密钥（会自动处理长度）
# ENCRYPTION_KEY=

# ====================
# LLM 配置
# ====================

# LLM API 密钥
LLM_API_KEY=

# 或使用 OpenAI API 密钥（备选）
OPENAI_API_KEY=

# LLM API 端点
LLM_ENDPOINT=http://localhost:11434/v1

# LLM 模型名称
LLM_MODEL=qwen2.5:14b

# ====================
# 服务器配置
# ====================

# 服务器监听地址
SERVER_ADDR=:8080

# 运行模式: debug / release
SERVER_MODE=debug

# ====================
# 数据库配置
# ====================

# 数据库连接字符串
DATABASE_DSN=./data/aiops.db

# ====================
# JWT 配置
# ====================

# JWT 签名密钥（生产环境必须修改）
JWT_SECRET=change-this-secret-in-production

# ====================
# 日志配置
# ====================

# 日志级别: debug / info / warn / error
# LOG_LEVEL=info

# 日志格式: json / text
# LOG_FORMAT=json

# 日志输出: stdout / 文件路径
# LOG_OUTPUT=stdout
